################################
# Audio Deepfake Detection
################################

# Raw / processed audio datasets
app/domains/audio/data/
app/domains/audio/data/raw/
app/domains/audio/data/processed/

# Audio model weights & training artifacts
app/domains/audio/deepfake_detection/weights/
app/domains/audio/deepfake_detection/weights/**/*.pth
app/domains/audio/deepfake_detection/weights/**/*.pt
training_history_*.json

# Audio files
*.wav
*.flac
*.mp3
*.ogg
*.m4a

# Audio cached / temp features
*.npy
*.npz


